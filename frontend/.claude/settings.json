{
  "project": {
    "name": "Notes App Frontend",
    "type": "react-spa",
    "framework": "react",
    "language": "typescript"
  },
  "conventions": {
    "componentNaming": "PascalCase",
    "fileNaming": "PascalCase for components, kebab-case for utilities",
    "stateManagement": "React hooks (useState, useEffect, useCallback)",
    "styling": "Tailwind CSS with shadcn/ui components",
    "routing": "React Router v7"
  },
  "paths": {
    "components": "src/components",
    "pages": "src/pages",
    "hooks": "src/hooks",
    "api": "src/api",
    "types": "src/types",
    "lib": "src/lib"
  }
}
